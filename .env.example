# Google sign-in: OAuth 2.0 "Web application" client id from Google Cloud Console.
# Add your site (e.g. http://localhost:5173) under Authorized JavaScript origins.
# Copy this file to .env.local and fill it in; leave it empty to run the login page in preview mode.
VITE_GOOGLE_CLIENT_ID=

# Dev only: forward /api and /health to a deployed gateway instead of the local docker-compose one (http://localhost:5000).
# API_PROXY_TARGET=http://your-gateway.example.com
